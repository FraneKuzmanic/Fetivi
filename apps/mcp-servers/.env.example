HOST=127.0.0.1
PORT=3002
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://fetivi:fetivi@127.0.0.1:5433/fetivi
# Base of the servers' canonical URLs, the guest token audiences (production: https://mcp.<domain>,
# with MCP_ALLOWED_HOSTS=mcp.<domain>).
MCP_PUBLIC_URL=http://localhost:3002
# The chat backend that issues guest tokens, and its JWKS (production: https://app.<domain>/.well-known/jwks.json).
GUEST_TOKEN_ISSUER=http://localhost:3000
GUEST_TOKEN_JWKS_URL=http://127.0.0.1:3000/.well-known/jwks.json
