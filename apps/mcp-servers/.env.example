HOST=127.0.0.1
PORT=3002
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://fetivi:fetivi@127.0.0.1:5433/fetivi
# Base of the servers' canonical URLs, the guest token audiences (production: https://mcp.<domain>,
# with MCP_ALLOWED_HOSTS=mcp.<domain>).
MCP_PUBLIC_URL=http://localhost:3002
# The chat backend that issues guest tokens, and its JWKS (production: https://app.<domain>/.well-known/jwks.json).
GUEST_TOKEN_ISSUER=http://localhost:3000
GUEST_TOKEN_JWKS_URL=http://127.0.0.1:3000/.well-known/jwks.json
# Seals the create_order confirmation state (at least 32 characters; required in production, the
# same value in every instance).
# REQUEST_STATE_SECRET=
# The User-Agent sent to MET Norway, which requires the app name and a contact (a URL or email);
# production sets a reachable contact. Defaults to the project URL.
# WEATHER_USER_AGENT=Fetivi/0.1 (+https://github.com/FraneKuzmanic/Fetivi)
# Brave Search for web_fallback_search; without it the tool answers "not available".
# BRAVE_SEARCH_API_KEY=
# Voyage AI embeddings for catalog search; without it search matches words only.
# VOYAGE_API_KEY=

# Traces go to the Jaeger in docker-compose (docs/observability.md). Set true to switch tracing off.
# OTEL_SDK_DISABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
