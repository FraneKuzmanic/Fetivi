HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgres://fetivi:fetivi@127.0.0.1:5433/fetivi
WEB_ORIGIN=http://localhost:5174
# The guest app's origin; unit QR codes link to <GUEST_ORIGIN>/u/<slug>.
GUEST_ORIGIN=http://localhost:5173
# Mail: console logs it (development); resend sends it through Resend. Production requires
# resend, the key and a real MAIL_FROM.
MAIL_TRANSPORT=console
# RESEND_API_KEY=
# MAIL_FROM=Fetivi <notifications@your-domain>
# Resend's bounce/complaint webhook signing secret (whsec_...). Without it /webhooks/resend is off.
# Point the Resend webhook at https://host.<domain>/webhooks/resend; Caddy must route
# host.<domain>/webhooks/* to this process (deployment is ticket 47).
# RESEND_WEBHOOK_SECRET=
# Behind a reverse proxy, the addresses to trust for X-Forwarded-For (e.g. loopback). Leave unset otherwise.
# TRUST_PROXY=loopback
# Block media files; the back office and the chat backend must share this directory.
MEDIA_DIR=../../.data/media
# The house manual import; without it, imports fail as not configured.
# ANTHROPIC_API_KEY=
# Host phone alerts (VAPID): the public key of the jobs process's pair. Without it alerts are off.
# VAPID_PUBLIC_KEY=
# Stripe (sk_test_... in development), for Provider payment onboarding. Without it onboarding is off.
# STRIPE_SECRET_KEY=
# The Stripe webhook signing secret (whsec_...). Without it /webhooks/stripe is off. Locally:
# stripe listen --forward-connect-to localhost:3001/webhooks/stripe --print-secret (docs/stripe-test-mode.md).
# STRIPE_WEBHOOK_SECRET=
