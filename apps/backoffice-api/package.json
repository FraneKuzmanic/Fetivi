{
  "name": "@fetivi/backoffice-api",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx --import ./src/instrumentation.ts --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx --import ./src/instrumentation.ts src/index.ts",
    "admin:create": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx src/cli/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.5",
    "@fetivi/domain": "workspace:*",
    "@fetivi/egress": "workspace:*",
    "@fetivi/telemetry": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg-boss": "12.38.0",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6"
  }
}
