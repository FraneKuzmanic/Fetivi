{
  "name": "@fetivi/chat-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx --import ./src/instrumentation.ts --watch src/index.ts",
