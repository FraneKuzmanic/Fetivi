    "@fetivi/egress": "workspace:*",
    "@fetivi/mcp-servers": "workspace:*",
    "@fetivi/telemetry": "workspace:*",
    "@fetivi/ui": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@opentelemetry/api": "1.9.1",
    "ai": "7.0.142",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "luxon": "3.7.2",
    "pg-boss": "12.38.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-node": "2.12.0",
