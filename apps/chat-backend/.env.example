HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://fetivi:fetivi@127.0.0.1:5433/fetivi
# The origin the guest SPA is served from (it proxies /api here); write requests must carry it.
APP_ORIGIN=http://localhost:5173
# Behind a reverse proxy, the addresses to trust for X-Forwarded-For (e.g. loopback). Leave unset otherwise.
# TRUST_PROXY=loopback
# Guest tokens for the MCP servers. Without a key outside production an ephemeral one is made at boot.
# Make one with: openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256
# (PKCS8 PEM; a one-line value with literal \n between lines is accepted). Required in production.
# GUEST_TOKEN_PRIVATE_KEY=
GUEST_TOKEN_ISSUER=http://localhost:3000
# Base of the MCP servers' canonical URLs (production: https://mcp.<domain>).
MCP_PUBLIC_URL=http://localhost:3002
# Claude for the guest chat; without it /api/chat answers 503.
ANTHROPIC_API_KEY=
# How the chat reaches the guest tools: mcp (default, production) or inprocess (V0, evaluation only).
TOOL_TRANSPORT=mcp
# Only with inprocess: must equal the MCP servers' REQUEST_STATE_SECRET (both have the same dev default).
# REQUEST_STATE_SECRET=
# Block media files; the back office and the chat backend must share this directory.
MEDIA_DIR=../../.data/media
# Web push (VAPID): the public key of the jobs process's pair. Without it push is never offered.
# VAPID_PUBLIC_KEY=
# The User-Agent sent to MET Norway, which requires the app name and a contact (a URL or email);
# production sets a reachable contact. Defaults to the project URL.
# WEATHER_USER_AGENT=Fetivi/0.1 (+https://github.com/FraneKuzmanic/Fetivi)
# Only with inprocess: Brave Search for V0's web_fallback_search; without it the tool answers "not available".
# BRAVE_SEARCH_API_KEY=
