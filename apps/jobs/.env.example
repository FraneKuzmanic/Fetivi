DATABASE_URL=postgres://fetivi:fetivi@127.0.0.1:5433/fetivi
# Block translations fail as not-configured without it.
ANTHROPIC_API_KEY=
# Derives the per-order Provider link tokens. Required in production: a long random string.
# PROVIDER_LINK_SECRET=
# Where the Provider order page is served: the back-office origin.
PROVIDER_LINK_BASE_URL=http://localhost:5174
# The back-office origin, for links in host emails.
WEB_ORIGIN=http://localhost:5174
# Mail: console logs it (development); resend sends it through Resend. Production requires
# resend, the key and a real MAIL_FROM.
MAIL_TRANSPORT=console
# RESEND_API_KEY=
# MAIL_FROM=Fetivi <notifications@your-domain>
# The guest-app origin, for links in guest emails (required in production).
GUEST_ORIGIN=http://localhost:5173
# Web push (VAPID), both or neither; without them guest push is skipped.
# Generate a pair with: npx web-push@3.6.7 generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@your-domain
