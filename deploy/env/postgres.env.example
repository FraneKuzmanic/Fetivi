# Copy to deploy/env/postgres.env. Read by postgres and the backup sidecar.

# The database's single owner role (superuser: the migrations create postgis). Not exposed.
POSTGRES_USER=fetivi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fetivi
# The same values for WAL-G's connection from the backup sidecar.
PGUSER=fetivi
PGPASSWORD=change-me
PGDATABASE=fetivi
