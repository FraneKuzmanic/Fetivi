# Copy to deploy/env/backoffice-api.env.

# Production refuses to boot without Resend and a real sender.
MAIL_TRANSPORT=resend
RESEND_API_KEY=change-me
MAIL_FROM=Fetivi <notifications@example.com>
# Resend webhook signing secret (whsec_...), for https://host.<domain>/webhooks/resend.
RESEND_WEBHOOK_SECRET=
# Stripe secret key and the signing secret of https://host.<domain>/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The same value as in chat-backend.env and jobs.env.
VAPID_PUBLIC_KEY=
