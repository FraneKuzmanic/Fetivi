# Copy to deploy/env/jobs.env.

# openssl rand -hex 32.
PROVIDER_LINK_SECRET=change-me
# Must equal GUEST_LINK_SECRET in chat-backend.env.
GUEST_LINK_SECRET=change-me
# Production refuses to boot without Resend and a real sender.
MAIL_TRANSPORT=resend
RESEND_API_KEY=change-me
MAIL_FROM=Fetivi <notifications@example.com>
# Web push pair; the public key also goes in chat-backend.env and backoffice-api.env. Generate:
#   docker compose ... run --rm tools -c "packages/domain/node_modules/.bin/web-push generate-vapid-keys"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:change-me@example.com
# Stripe secret key, for checkout, capture, void and refund.
STRIPE_SECRET_KEY=
# Off until Jadrolinija gives written permission to poll its feed.
JADROLINIJA_RSS_ENABLED=false
