# Copy to deploy/env/chat-backend.env. Also read by the tools service (smoke check).

# P-256 key that signs guest tokens, as one line with literal \n:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | awk '{printf "%s\\n",$0}'
GUEST_TOKEN_PRIVATE_KEY=change-me
# openssl rand -hex 32. Must equal GUEST_LINK_SECRET in jobs.env.
GUEST_LINK_SECRET=change-me
# Web push public key; the same value in backoffice-api.env and jobs.env.
VAPID_PUBLIC_KEY=
# Ferryhopper's public MCP server; empty disables ferries.
FERRYHOPPER_MCP_URL=https://mcp.ferryhopper.com/mcp
