# Copy to deploy/env/common.env. Read by every Node service, migrate and tools.

NODE_ENV=production
# The password must equal POSTGRES_PASSWORD in postgres.env.
DATABASE_URL=postgres://fetivi:change-me@postgres:5432/fetivi
# MET Norway, DHMZ and Jadrolinija want an identifying agent with a reachable contact.
WEATHER_USER_AGENT=Fetivi/0.1 (+mailto:change-me@example.com)
# Claude for the guest chat, translations and the house manual import.
ANTHROPIC_API_KEY=
# Uncomment to turn tracing off.
# OTEL_SDK_DISABLED=true
