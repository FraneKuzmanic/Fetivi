# Copy to deploy/env/backup.env. Read by postgres (archive_command) and the backup sidecar.
# One S3-compatible bucket off the VPS provider (e.g. Cloudflare R2 or Backblaze B2).

# WAL-G: continuous WAL archiving and daily base backups.
WALG_S3_PREFIX=s3://change-me-bucket/wal-g
# One key pair, scoped to the bucket; restic reads the same variables.
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_ENDPOINT=https://change-me.r2.cloudflarestorage.com
# R2 uses auto; MinIO and most others us-east-1.
AWS_REGION=auto
AWS_S3_FORCE_PATH_STYLE=true
# Client-side encryption key: openssl rand -hex 32.
WALG_LIBSODIUM_KEY=change-me
WALG_LIBSODIUM_KEY_TRANSFORM=hex

# restic: daily snapshots of the media volume, in the same bucket.
RESTIC_REPOSITORY=s3:https://change-me.r2.cloudflarestorage.com/change-me-bucket/restic-media
# openssl rand -hex 32.
RESTIC_PASSWORD=change-me

# Keep WALG_LIBSODIUM_KEY and RESTIC_PASSWORD in the password manager too, off the server:
# without them the backups cannot be read.
