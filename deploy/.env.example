# Copy to deploy/.env on the server. Read by Compose for ${...} interpolation only.

# The registered domain; the four origins are app., host., mcp. and sandbox. under it.
DOMAIN=example.com
# Let's Encrypt account email. Required: Caddy rejects an empty value.
ACME_EMAIL=change-me@example.com

# The dedicated smoke unit (back office) and its Stay's PIN. Empty skips the guest PIN flow and
# the MCP Inspector check in the smoke check.
SMOKE_UNIT_SLUG=
SMOKE_PIN=

# The images and the WAL-G/restic downloads are amd64. An arm64 server (e.g. Hetzner CAX) needs
# the arm64 assets in deploy/postgres/Dockerfile (RUNBOOK.md).
