{
  "name": "@fetivi/domain",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./vocabulary": "./src/property/vocabulary.ts",
    "./wizard": "./src/property/wizard.ts",
    "./catalog-vocabulary": "./src/catalog/vocabulary.ts",
    "./offer-vocabulary": "./src/offers/vocabulary.ts",
    "./order-vocabulary": "./src/orders/vocabulary.ts",
    "./handover": "./src/stays/handover.ts",
    "./projection-types": "./src/projection/types.ts",
    "./stay-vocabulary": "./src/stays/vocabulary.ts",
    "./about-me-vocabulary": "./src/about-me/vocabulary.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx src/db/migrate-cli.ts",
    "db:seed": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx src/catalog/seed-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "drizzle-orm": "0.45.4",
    "luxon": "3.7.2",
    "mammoth": "1.13.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "unpdf": "1.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fetivi/egress": "workspace:*",
    "@types/luxon": "3.7.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.0",
    "jszip": "3.10.1"
  }
}
